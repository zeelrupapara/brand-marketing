{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "unload=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/brand-consistency",
      "destination": "/articles/brand-consistency/",
      "permanent": true
    },
    {
      "source": "/organic-social-media-management",
      "destination": "/articles/organic-social-media-management/",
      "permanent": true
    },
    {
      "source": "/why-digital-presence-consistency-matters",
      "destination": "/articles/why-digital-presence-consistency-matters/",
      "permanent": true
    },
    {
      "source": "/how-to-maintain-brand-voice",
      "destination": "/articles/how-to-maintain-brand-voice/",
      "permanent": true
    },
    {
      "source": "/brand-consistency/",
      "destination": "/articles/brand-consistency/",
      "permanent": true
    },
    {
      "source": "/organic-social-media-management/",
      "destination": "/articles/organic-social-media-management/",
      "permanent": true
    },
    {
      "source": "/why-digital-presence-consistency-matters/",
      "destination": "/articles/why-digital-presence-consistency-matters/",
      "permanent": true
    },
    {
      "source": "/how-to-maintain-brand-voice/",
      "destination": "/articles/how-to-maintain-brand-voice/",
      "permanent": true
    }
  ]
}
